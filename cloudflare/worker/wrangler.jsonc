{
  "name": "ogwa-demo",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{"type": "Data", "globs": ["**/*.json", "**/*.gz"], "fallthrough": true}],
  "assets": {"directory": "public", "not_found_handling": "none"},
  "d1_databases": [{"binding": "DB", "database_name": "ogwa-demo-2", "database_id": "1b8fc874-d8b0-4ec5-9225-dadc73c6ec83"}],
  "vars": {"OGWA_RUNTIME_MODE": "demo", "OGWA_DEMO_DATASET": "genesee-press"},
  "observability": {"enabled": true},
  "limits": {"cpu_ms": 2000}
}
