# OGWA configuration reference. NAMES AND PLACEHOLDERS ONLY - never put real values here.
#
# OGWA reads the process environment; it does NOT auto-load .env files.
# Supply credentials from an approved source (see docs/security/credentials.md).
# Unknown OGWA_* keys are rejected at startup.

# production (default: the standard runtime) | demo (the sealed demo profile; docs/demo-mode.md).
# demo forces LOCAL_SYNTHETIC, refuses every Okta/AAP setting and credential below, and uses
# its own store (default sqlite:///var/ogwa-demo.sqlite3). Unknown values fail startup.
OGWA_RUNTIME_MODE=production
# Demo only: the synthetic dataset to serve, by its selector in app.demo.datasets:
# genesee-press (default; seed namespace genesee-press-v1; the shared synthetic world) |
# null-meridian (legacy; null-meridian-v1) | classic (the 16-scenario lifecycle world).
# Must be blank outside demo. An unknown or missing dataset fails closed.
OGWA_DEMO_DATASET=

# LOCAL_SYNTHETIC (default) | READ_ONLY_PRODUCTION | DRY_RUN_MUTATION
# PRODUCTION_MUTATION is rejected by this build and cannot be enabled via configuration.
OGWA_EXECUTION_MODE=LOCAL_SYNTHETIC

# DEBUG | INFO | WARNING | ERROR
OGWA_LOG_LEVEL=INFO

# Outbound HTTP. Values outside the hard ceilings fail startup.
# connect 0.5-30s, read 1-120s, retries 0-5, concurrency 1-4.
OGWA_HTTP_CONNECT_TIMEOUT_SECONDS=5
OGWA_HTTP_READ_TIMEOUT_SECONDS=30
OGWA_HTTP_MAX_RETRIES=3
OGWA_HTTP_MAX_CONCURRENCY=2

# Okta base URL, e.g. https://<your-org>.okta.com (https only; no path, query, or credentials).
OGWA_OKTA_ORG_URL=
# SECRET - supply at runtime from an approved source. Leave blank in this file.
OGWA_OKTA_API_TOKEN=

# Lifecycle/audit store. Local SQLite only in this build (PostgreSQL URLs are refused until an
# approved driver exists). Relative paths resolve against the project root; var/ is git-ignored.
# Never embed credentials in this URL.
OGWA_DATABASE_URL=sqlite:///var/ogwa-local.sqlite3

# AAP controller base URL (https only).
OGWA_AAP_URL=
# SECRET - supply at runtime from an approved source. Leave blank in this file.
OGWA_AAP_TOKEN=
