# OGWA configuration reference. Every setting is optional; the demo needs none of them.
#
# OGWA reads the process environment only; it does NOT auto-load .env files.
# This build runs in Demo Mode only (docs/demo-mode.md). It reads no credential, and it refuses
# to start if a live-integration setting (Okta, AAP, outbound HTTP), an unknown OGWA_* key, or an
# Okta/AAP/AD credential variable is present.

# demo is the only runtime mode. Any other value refuses startup.
OGWA_RUNTIME_MODE=demo
# LOCAL_SYNTHETIC is the only execution mode. Any other value refuses startup.
OGWA_EXECUTION_MODE=LOCAL_SYNTHETIC
# The synthetic dataset, by its selector in app.demo.datasets: null-meridian (default; seed
# namespace null-meridian-v1) or classic (the 16-scenario lifecycle world).
OGWA_DEMO_DATASET=null-meridian

# DEBUG | INFO | WARNING | ERROR
OGWA_LOG_LEVEL=INFO

# The demo store: a local SQLite file. Relative paths resolve against the project root; var/ is
# git-ignored.
OGWA_DATABASE_URL=sqlite:///var/ogwa-demo.sqlite3
